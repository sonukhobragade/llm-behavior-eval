# Copy to .env and fill in. Never commit .env.

# ── Transport ─────────────────────────────────────────
# sse     the bespoke assistant API in llmeval/client.py
# openai  any OpenAI-compatible /v1/chat/completions endpoint
#
# The quickest way to see the suite work is a local model, which costs nothing
# and needs no account:
#
#   ollama serve && ollama pull llama3.1
#
# Then uncomment the three lines below. A local model is also the right place
# to run the red-team suite: firing jailbreak prompts at a hosted endpoint may
# breach its terms, and the result describes the provider's safety stack as
# much as the model.
LLMEVAL_TRANSPORT=sse
# LLMEVAL_TRANSPORT=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.1
# OPENAI_SYSTEM_PROMPT=You are a customer support assistant for an online store.
# Deterministic by default. Raise it only if you are deliberately testing
# variance, and expect check results to move between runs when you do.
# OPENAI_TEMPERATURE=0

# Anthropic. Not OpenAI-compatible, so it has its own transport.
# Setting ANTHROPIC_API_KEY alone selects it.
# LLMEVAL_TRANSPORT=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_MAX_TOKENS=1024        # required by the API; this is the default
# ANTHROPIC_SYSTEM_PROMPT=You are a customer support assistant for an online store.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_VERSION=2023-06-01

# Which block below to use: qa or prod
ENV=qa

# ── QA ────────────────────────────────────────────────
QA_SSE_URL=https://qa.example.com/chat/sse
QA_USER_ID=
QA_PHONE_NUMBER=
QA_RELATIONSHIP_ID=0
QA_ASSISTANT_ID=
QA_APP_VERSION=1.0.0
QA_USER_MGMT_BASE_URL=https://qa-api.example.com
QA_DELETE_AUTH_TOKEN=
QA_SUGGESTIONS_BASE_URL=https://qa-api.example.com
QA_SUGGESTION_CATEGORIES=
QA_SUGGESTION_ASSISTANT_ID=
QA_OTP=
QA_SUGGESTIONS_JWT=

# ── PROD ──────────────────────────────────────────────
# Red-teaming production sends adversarial prompts to a live system.
# Make that a deliberate choice.
PROD_SSE_URL=
PROD_USER_ID=
PROD_PHONE_NUMBER=
PROD_ASSISTANT_ID=
PROD_APP_VERSION=
PROD_USER_MGMT_BASE_URL=
PROD_DELETE_AUTH_TOKEN=

# LLM judge (optional, for grading beyond the deterministic checks)
ANTHROPIC_API_KEY=

# Override the domain vocabulary in llmeval/patterns.py
# LLMEVAL_PATTERNS=./patterns.json

# ── Session contract ──────────────────────────────────────────────────────
# The header/payload fields the assistant expects. The built-in set is one
# common mobile-app shape; add or override with JSON objects.
# EXTRA_HEADERS={"X-Tenant": "acme"}
# EXTRA_PAYLOAD={"channel": "web"}
EXTRA_HEADERS=
EXTRA_PAYLOAD=
APP_TYPE=android
COUNTRY_CODE=IN
